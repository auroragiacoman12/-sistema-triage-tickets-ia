      "parameters": {
        "jsCode": "// Toma el texto crudo que regresó Claude\nconst rawText = $input.item.json.content[0].text;\n\n// Quita los ```json y ``` que envuelven la respuesta\nconst cleanText = rawText\n  .replace(/```json\\n?/g, '')\n  .replace(/```/g, '')\n  .trim();\n\n// Convierte el texto limpio a un objeto JSON real\nconst parsed = JSON.parse(cleanText);\n\n// Regresa el objeto parseado, junto con los datos originales del ticket\nreturn {\n  json: {\n    ...$('Search records').item.json,\n    categoria: parsed.categoria,\n    urgencia: parsed.urgencia\n  }\n};"
      },
